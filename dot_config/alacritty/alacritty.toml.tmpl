[general]
import = ["~/.config/alacritty/nord.toml"]

[font]
size = {{ if eq .chezmoi.os "darwin" }}16{{ else }}12{{ end }}

[font.normal]
family = "SpaceMono Nerd Font Mono"
style = "Regular"

[font.bold]
family = "SpaceMono Nerd Font Mono"
style = "Bold"

[font.italic]
family = "SpaceMono Nerd Font Mono"
style = "Italic"

[font.bold_italic]
family = "SpaceMono Nerd Font Mono"
style = "Bold Italic"

[window]
decorations = "none"
padding = { x = 5, y = 0 }
dynamic_padding = true
opacity = 0.8
